    "notes":  [
                  "런처 왼쪽 위에 런처 버전이 보여요",
                  "런처 아래 포켓몬이 60마리 중에서 무작위로 나와요"
              ],
    "history":  [
                    {
                        "version":  "1.1.0",
                        "notes":  [
                                      "런처에 업데이트 버튼이 생겼어요"
                                  ]
                    },
                    {
                        "version":  "1.1.1",
                        "notes":  [
                                      "게임을 끄거나 런처를 켜 둔 채로 있어도 새 버전을 확인해요"
                                  ]
                    },
                    {
                        "version":  "1.1.2",
                        "notes":  [
                                      "서버 주소가 자동으로 설정돼요",
                                      "타이틀 화면의 게임시작 버튼으로 서버에 바로 들어가요"
                                  ]
                    },
                    {
                        "version":  "1.1.3",
                        "notes":  [
                                      "CobbleMotion 같은 리소스팩이 자동으로 켜져요"
                                  ]
                    },
                    {
                        "version":  "1.1.4",
                        "notes":  [
                                      "서버 주소를 묻는 창을 없앴어요"
                                  ]
                    },
                    {
                        "version":  "1.2.0",
                        "notes":  [
                                      "업데이트할 때 바뀐 점을 보여주는 패치노트 창이 생겼어요",
                                      "서버 주소를 묻는 창이 더 이상 뜨지 않아요",
                                      "CobbleMotion과 미니맵 아이콘 리소스팩이 자동으로 켜져요",
                                      "런처를 켜 둔 채로 있어도 새 버전을 알아서 확인해요"
                                  ]
                    },
                    {
                        "version":  "1.2.1",
                        "notes":  [
                                      "줌(C키)과 연결된 유리 텍스처가 추가됐어요",
                                      "연결된 유리 효과가 처음부터 켜져 있어요"
                                  ]
                    },
                    {
                        "version":  "1.2.2",
                        "notes":  [
                                      "업데이트를 받을 때 '파일이 손상됐어요' 오류가 나던 문제를 고쳤어요"
                                  ]
                    },
                    {
                        "version":  "1.2.3",
                        "notes":  [
                                      "런처 아래 풀밭에 포켓몬들이 걸어 다녀요 (피카츄, 이브이, 파이리 등)"
                                  ]
                    },
                    {
                        "version":  "1.2.4",
                        "notes":  [
                                      "런처 왼쪽 위에 런처 버전이 보여요",
                                      "런처 아래 포켓몬이 60마리 중에서 무작위로 나와요"
                                  ]
                    }
                ]
